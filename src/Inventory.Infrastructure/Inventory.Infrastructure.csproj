<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inventory.Infrastructure — persistence, identity, external services, health probes.
    Depends on Application and Domain.  The Api reaches it only through the
    composition root (AddInfrastructure), never by referencing its types directly
    (ADR-002; enforced by LayeringRules).
  -->

  <PropertyGroup>
    <RootNamespace>Inventory.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Raw connectivity for the readiness probe. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
